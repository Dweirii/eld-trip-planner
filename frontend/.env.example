# Where the Django API runs (no trailing slash needed). Local dev: `uv run python manage.py runserver 8000` in backend/.
# Read at BUILD time (the /api/* rewrite in next.config.ts) AND at RUN time (server rendering of /trips/[id]),
# so on Vercel set it for both. A Vercel build fails fast if it is missing.
API_BASE_URL=http://localhost:8000
